<% bg_image =
  if @list.photo.attached?
    cl_image_path(@list.photo.key, width: 1200, height: 300, crop: :fill, quality: :auto, fetch_format: :auto)
  else
    asset_path("list_background.jpg")
  end
%>

<div class="banner-show position-relative"
      style="background-image: url('<%= bg_image %>')">

  <h1><%= @list.name %></h1>
  <div class="position-absolute top-0 end-0 p-2 m-2 movie-tag">
    <%= pluralize(@bookmarks.count, "movie") %>
  </div>
</div>

<div class="container py-5">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <span class="mb-2 d-block">
      <small>
        <em class="text-muted">
          <%= "You haven't saved any movies yet!" if @list.movies.empty? %>
        </em>
      </small>
    </span>

    <div class="d-flex gap-3">
      <button class="btn btn-success text-white"
              data-bs-toggle="modal"
              data-bs-target="#new_movie_modal">
        Bookmark a movie
      </button>

      <%= link_to "Delete this list",
        list_path(@list),
        class: "btn btn-danger text-white",
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <%= render "bookmarks/bookmarks", bookmarks: @bookmarks %>
  <%= render "reviews/reviews", list: @list, review: @review %>
</div>

<%= render "bookmarks/modal", list: @list, bookmark: @bookmark %>

<% if @bookmark.errors.any? %>
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
  <script>
    var myModal = new bootstrap.Modal(document.getElementById('new_movie_modal'));
    myModal.show();
  </script>
<% end %>
