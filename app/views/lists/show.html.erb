<h1><%= @list.name %></h1>

<%= link_to "Bookmark a movie", new_list_bookmark_path(@list) %>

<div>
  <% @bookmarks.each do |bookmark| %>
    <% movie = bookmark.movie %>
    <div>
      <%= image_tag movie.poster_url, alt: "movie.title" %>
      <%= movie.title %>
      <%= movie.rating %>
      <%= movie.overview %>
      <%= bookmark.comment %>

      <%= link_to "Delete",
        lists_path(@list),
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>
</div>
