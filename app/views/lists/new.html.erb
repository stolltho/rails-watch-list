<div class="banner-show">
  <h1>Create New Movie List</h1>
</div>

<div class="container py-5">
  <div class="row">
    <div class="col-12 col-md-6 offset-lg-3">
      <div class="bg-white rounded p-3 shadow">
        <%= simple_form_for @list do |f| %>
          <%= f.input :name, placeholder: 'Drama', input_html: { class: 'placeholder-low-opacity' } %>
          <%= f.input :photo, as: :file %>
          <div class="d-flex justify-content-between">
            <%= f.submit class: 'btn btn-success text-white' %>
            <%= link_to "Cancel", lists_path, class: "btn btn-danger text-white" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
