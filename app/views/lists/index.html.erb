<div class="banner-index">
  <div>
    <h1>Save any kind of movies</h1>
  </div>
</div>

<div class="container py-5">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <h3 class="mb-0">My Movie Lists</h3>
    <%= link_to "Create a movie list", new_list_path, class: "btn btn-success text-white" %>
  </div>

  <div class="row">
      <% @lists.each do |list| %>
        <div class="col-md-4 col-sm-12 mb-3">
          <div class="card-category"
                <% if list.photo.attached? %>
                style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)),
                url('<%= cl_image_path(list.photo.key, width: 1200, height: 300, crop: :fill) %>')"
              <% end %>>

          <%= link_to list_path(list),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this list?" },
                class: "delete-icon" do %>
              <i class="fa-solid fa-trash"></i>
            <% end %>
            <%= link_to list.name, list_path(list), class: "text-decoration-none text-white" %>
          </div>
        </div>
      <% end %>
  </div>

</div>
