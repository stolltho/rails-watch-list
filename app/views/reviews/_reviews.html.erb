<hr class="my-5">

<div class="row">
  <div class="col-12 col-sm-6">
    <h3>Reviews</h3>

    <% if list.reviews.empty? %>
      <small><em class="text-muted">Be the first one to review this list</em></small>
    <% end %>

    <% list.reviews.each do |review| %>
      <div>
        <% review.rating.times do %>
          <span class="star-yellow">★</span>
        <% end %>
        <small class="text-muted">
          <em><%= distance_of_time_in_words_to_now(review.created_at) %> ago</em>
        </small>
        <p class="mb-0"><%= review.comment %></p>
      </div>
      <hr>
    <% end %>
  </div>

  <div class="col-12 col-sm-6">
    <div class="bg-white rounded p-3">
      <h5>Add your review</h5>

      <%= simple_form_for([list, review]) do |f| %>
        <%= f.input :comment, placeholder: "Add your review here..." %>

        <label class="form-label">Rating</label>
        <div class="star-rating mb-1">
          <% 5.downto(1) do |n| %>
            <input type="radio" id="star<%= n %>" name="review[rating]" value="<%= n %>" <%= "checked" if review.rating == n %> />
            <label for="star<%= n %>">★</label>
          <% end %>
        </div>

        <% if review.errors[:rating].any? %>
          <div class="text-danger small mb-2">Rating must be added</div>
        <% end %>

        <%= f.submit class: "btn btn-magic mt-2" %>
      <% end %>
    </div>
  </div>
</div>
